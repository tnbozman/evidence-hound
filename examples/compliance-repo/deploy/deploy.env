# Example Pty Ltd's deployment settings for Evidence Hound's reference Compose stack (deploy/compose in the public repo).
# On the host, link it as that folder's .env: ln -s /opt/compliance/deploy/deploy.env /opt/evidence-hound/deploy/compose/.env
# Every setting is documented in deploy/compose/.env.example. Nothing here is secret: the secrets are files in
# HOUND_SECRETS_DIR on the host, never in this repo. Change these through a pull request like the rest of the repo.

# The stack plus this repo's override (paths relative to deploy/compose, or absolute).
COMPOSE_FILE=compose.yml:/opt/compliance/deploy/compose.override.yml

# CISO Assistant release. Snapshot the VM before upgrading.
CA_VERSION=v4.3.4
CA_HOSTNAME=ciso.example.com
CA_HTTPS_PORT=443
TZ=Australia/Sydney

# The collector runner image, pinned to a release. Move it with EVIDENCE_HOUND_REF in .github/workflows/compliance.yml.
HOUND_RUNNER_IMAGE=ghcr.io/tnbozman/evidence-hound:1.0.0

# This repo, checked out on the host and mounted read-only into the runner at /config.
HOUND_CONFIG_DIR=/opt/compliance
HOUND_CONFIG_FILE=hound.yaml
# The Docker secrets files (postgres_password, django_secret_key, hound_ca_token, m365_client_certificate).
HOUND_SECRETS_DIR=/etc/evidence-hound/secrets
