<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Needed for IDE0005 on build; XML docs are not required on every member. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Authors>Evidence Hound contributors</Authors>
    <Product>Evidence Hound</Product>
    <Copyright>Copyright Evidence Hound contributors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <!-- s13-03: the version comes from the latest vX.Y.Z git tag (MinVer); between releases it is a pre-release of the next patch. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>alpha.0</MinVerDefaultPreReleaseIdentifiers>
    <!-- Before the first tag, builds are pre-releases of 1.0.0, so profiles that require hound >=0.1 load. -->
    <MinVerMinimumMajorMinor>1.0</MinVerMinimumMajorMinor>
    <!-- Package metadata, SourceLink (built into the SDK) and symbols for every package. -->
    <PackageProjectUrl>https://github.com/tnbozman/evidence-hound</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tnbozman/evidence-hound</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageTags>compliance;grc;ciso-assistant;essential-eight;evidence</PackageTags>
  </PropertyGroup>

  <!-- Each package carries the README.md next to its project file. -->
  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)/README.md')">
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/README.md')">
    <None Include="$(MSBuildProjectDirectory)/README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <!-- GitHub Actions sets GITHUB_ACTIONS=true; CI can also pass -p:ContinuousIntegrationBuild=true. -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
