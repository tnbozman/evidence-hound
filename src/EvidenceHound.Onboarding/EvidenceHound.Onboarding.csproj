<Project Sdk="Microsoft.NET.Sdk">
  <!--
    hound onboard only. The language model adapters and everything that sends to a model live here, so the runner, the scheduler, the
    core and the collectors cannot reach a model: ArchitectureTests fails if any of them references this project or a model SDK.
  -->
  <PropertyGroup>
    <RootNamespace>EvidenceHound.Onboarding</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Anthropic" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="OpenAI" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="EvidenceHound.Onboarding.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\EvidenceHound.Core\EvidenceHound.Core.csproj" />
  </ItemGroup>
</Project>
