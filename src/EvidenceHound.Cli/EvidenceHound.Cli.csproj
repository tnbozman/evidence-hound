<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>hound</AssemblyName>
    <RootNamespace>EvidenceHound.Cli</RootNamespace>
    <!-- The runner image publishes for one of these, so native libraries for other platforms stay out of it. -->
    <!-- Not when packing: the tool package is framework-dependent and runs wherever .NET runs. -->
    <RuntimeIdentifiers Condition="'$(_IsPacking)' != 'true'">linux-x64;linux-arm64</RuntimeIdentifiers>
    <!-- s13-03: also a .NET tool. Installing the EvidenceHound.Cli tool gives the hound command. -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>hound</ToolCommandName>
    <PackageId>EvidenceHound.Cli</PackageId>
    <Description>The hound command: collect evidence, map it to framework requirements and keep CISO Assistant current, with onboarding, reporting and review for a small GRC team.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="EvidenceHound.Cli.Tests" />
    <InternalsVisibleTo Include="EvidenceHound.Functional.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- hound init writes these into a new compliance repo. The runner image's build stage copies them in too. -->
    <EmbeddedResource Include="..\..\mappings\essential-eight-2023.yaml" LogicalName="init/mappings/essential-eight-2023.yaml" />
    <EmbeddedResource Include="..\..\mappings\crosswalks\*.yaml" LogicalName="crosswalks/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\frameworks\essential-eight-2023.json" LogicalName="init/frameworks/essential-eight-2023.json" />
    <EmbeddedResource Include="..\..\mappings\disp.yaml" LogicalName="init/mappings/disp.yaml" />
    <EmbeddedResource Include="..\..\frameworks\disp.yaml" LogicalName="init/frameworks/disp.yaml" />
    <EmbeddedResource Include="..\..\frameworks\disp.json" LogicalName="init/frameworks/disp.json" />
    <EmbeddedResource Include="..\..\examples\compliance-repo\.gitignore" LogicalName="init/.gitignore" />
    <EmbeddedResource Include="..\..\examples\compliance-repo\manual-sources\weekly-compliance-review.md" LogicalName="init/manual-sources/weekly-compliance-review.md" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\EvidenceHound.CisoAssistant\EvidenceHound.CisoAssistant.csproj" />
    <ProjectReference Include="..\EvidenceHound.Core\EvidenceHound.Core.csproj" />
    <ProjectReference Include="..\EvidenceHound.Core.Yaml\EvidenceHound.Core.Yaml.csproj" />
    <ProjectReference Include="..\EvidenceHound.Onboarding\EvidenceHound.Onboarding.csproj" />
    <ProjectReference Include="..\EvidenceHound.Runtime\EvidenceHound.Runtime.csproj" />
    <ProjectReference Include="..\EvidenceHound.Transport.Kafka\EvidenceHound.Transport.Kafka.csproj" />
  </ItemGroup>
</Project>
