{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tnbozman/evidence-hound/schemas/scope.schema.json",
  "title": "Evidence Hound scope file",
  "description": "One file of a compliance repo's scope: setup.yaml (organisation, frameworks, domains), controls.yaml (applied controls), audits/<audit>.yaml (one compliance assessment), access.yaml (users, teams and role assignments), settings.yaml (feature flags and general settings), or third-parties/<entity>.yaml (one supplier or other third party). Guide: docs/scope.md.",
  "oneOf": [
    {
      "$ref": "#/$defs/setup"
    },
    {
      "$ref": "#/$defs/controls"
    },
    {
      "$ref": "#/$defs/audit"
    },
    {
      "$ref": "#/$defs/access"
    },
    {
      "$ref": "#/$defs/settings"
    },
    {
      "$ref": "#/$defs/thirdParty"
    }
  ],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "names": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "requirement": {
      "description": "A requirement by ref_id, or by URN (a value starting with urn:).",
      "$ref": "#/$defs/text"
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domains"
      ],
      "properties": {
        "organisation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "root_folder": {
              "description": "The existing folder the domains sit under. Default Global.",
              "$ref": "#/$defs/text"
            },
            "entity": {
              "description": "The organisation's own entity (CISO Assistant's main entity). It is only ever updated, never created or deleted.",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "$ref": "#/$defs/text"
                },
                "description": {
                  "type": "string"
                },
                "mission": {
                  "type": "string"
                },
                "country": {
                  "type": "string",
                  "pattern": "^[A-Z]{2}$",
                  "description": "ISO 3166-1 alpha-2, such as AU."
                },
                "currency": {
                  "type": "string",
                  "pattern": "^[A-Z]{3}$",
                  "description": "ISO 4217, such as AUD."
                },
                "identifiers": {
                  "description": "Legal identifiers, such as ABN, as name: value.",
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "frameworks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/framework"
          }
        },
        "libraries": {
          "description": "Other libraries to load by URN, such as the mapping sets between the frameworks.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "domains": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/domain"
          }
        }
      }
    },
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "urn"
      ],
      "properties": {
        "urn": {
          "description": "The framework URN.",
          "type": "string",
          "pattern": "^urn:"
        },
        "library": {
          "description": "The library URN to load from CISO Assistant's stored libraries.",
          "type": "string",
          "pattern": "^urn:"
        },
        "file": {
          "description": "A custom library file to upload, relative to setup.yaml.",
          "$ref": "#/$defs/text"
        },
        "snapshot": {
          "description": "The framework snapshot (hound framework snapshot), relative to setup.yaml, for offline checks.",
          "$ref": "#/$defs/text"
        }
      }
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "not": {
        "required": [
          "perimeter",
          "perimeters"
        ]
      },
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "type": "string"
        },
        "perimeter": {
          "$ref": "#/$defs/perimeter"
        },
        "perimeters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/perimeter"
          }
        },
        "systems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/system"
          }
        }
      }
    },
    "perimeter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
        },
        "ref_id": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
        },
        "ref_id": {
          "$ref": "#/$defs/text"
        },
        "type": {
          "enum": [
            "primary",
            "supporting"
          ]
        },
        "description": {
          "type": "string"
        },
        "owner": {
          "$ref": "#/$defs/text"
        },
        "parents": {
          "$ref": "#/$defs/names"
        },
        "tags": {
          "description": "Per-framework labels, such as an Essentials domain or cui: \"true\".",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controls"
      ],
      "properties": {
        "controls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/control"
          }
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref_id",
        "name"
      ],
      "properties": {
        "ref_id": {
          "$ref": "#/$defs/text"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "type": "string"
        },
        "domain": {
          "description": "A domain from setup.yaml; left out for the global domain.",
          "$ref": "#/$defs/text"
        },
        "owner": {
          "$ref": "#/$defs/text"
        },
        "status": {
          "enum": [
            "to_do",
            "in_progress",
            "on_hold",
            "active",
            "degraded",
            "deprecated",
            "--"
          ]
        },
        "priority": {
          "type": "string",
          "pattern": "^[1-4]$"
        },
        "category": {
          "$ref": "#/$defs/text"
        },
        "eta": {
          "$ref": "#/$defs/date"
        },
        "systems": {
          "$ref": "#/$defs/names"
        },
        "reference_control": {
          "type": "string",
          "pattern": "^urn:"
        },
        "documents": {
          "description": "Ids of documents declared in audit files.",
          "$ref": "#/$defs/names"
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref_id",
        "name",
        "framework",
        "domain",
        "perimeter",
        "unlisted"
      ],
      "properties": {
        "ref_id": {
          "$ref": "#/$defs/text"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "framework": {
          "type": "string",
          "pattern": "^urn:"
        },
        "groups": {
          "$ref": "#/$defs/names"
        },
        "domain": {
          "$ref": "#/$defs/text"
        },
        "perimeter": {
          "$ref": "#/$defs/text"
        },
        "eta": {
          "$ref": "#/$defs/date"
        },
        "due_date": {
          "$ref": "#/$defs/date"
        },
        "authors": {
          "$ref": "#/$defs/names"
        },
        "reviewers": {
          "$ref": "#/$defs/names"
        },
        "field_visibility": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "auditor": {
                "enum": [
                  "edit",
                  "read",
                  "hidden"
                ]
              },
              "respondent": {
                "enum": [
                  "edit",
                  "read",
                  "hidden"
                ]
              }
            }
          }
        },
        "systems": {
          "$ref": "#/$defs/names"
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/document"
          }
        },
        "controls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/auditControl"
          }
        },
        "assessments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assessment"
          }
        },
        "cycle": {
          "description": "Run the audit in periods: each period is its own audit, <ref_id>-<label> such as EX-E8-BACKUP-2026Q4.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "period",
            "starts"
          ],
          "properties": {
            "period": {
              "enum": [
                "month",
                "quarter",
                "half_year",
                "year"
              ]
            },
            "starts": {
              "description": "The first period's first day: the first of a month.",
              "$ref": "#/$defs/date"
            },
            "close": {
              "description": "How an ended period closes: sign_off (the default) locks it once sign_offs records it; auto locks it when it ends.",
              "enum": [
                "sign_off",
                "auto"
              ]
            }
          }
        },
        "sign_offs": {
          "description": "Each ended period's sign-off, so the approval is a reviewed commit.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "period",
              "by",
              "date"
            ],
            "properties": {
              "period": {
                "description": "The period's label, such as 2026Q4.",
                "$ref": "#/$defs/text"
              },
              "by": {
                "$ref": "#/$defs/text"
              },
              "date": {
                "$ref": "#/$defs/date"
              }
            }
          }
        },
        "unlisted": {
          "description": "What happens to in-group requirements this file does not list.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result"
          ],
          "properties": {
            "result": {
              "enum": [
                "not_assessed",
                "not_applicable"
              ]
            },
            "reason": {
              "$ref": "#/$defs/text"
            }
          },
          "if": {
            "properties": {
              "result": {
                "const": "not_applicable"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "files": {
          "description": "Paths or globs, relative to the compliance repo.",
          "$ref": "#/$defs/names"
        },
        "systems": {
          "$ref": "#/$defs/names"
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement"
          }
        }
      }
    },
    "auditControl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref_id"
      ],
      "properties": {
        "ref_id": {
          "$ref": "#/$defs/text"
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement"
          }
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "result"
      ],
      "oneOf": [
        {
          "required": [
            "ref"
          ]
        },
        {
          "required": [
            "urn"
          ]
        }
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/text"
        },
        "urn": {
          "type": "string",
          "pattern": "^urn:"
        },
        "status": {
          "enum": [
            "to_do",
            "in_progress",
            "in_review",
            "done"
          ]
        },
        "result": {
          "enum": [
            "compliant",
            "partially_compliant",
            "non_compliant",
            "not_assessed",
            "not_applicable"
          ]
        },
        "observation": {
          "type": "string"
        }
      }
    },
    "email": {
      "type": "string",
      "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
    },
    "access": {
      "description": "Who can do what in CISO Assistant. Never passwords or tokens: people set their own password from CISO Assistant's invitation.",
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "users"
          ]
        },
        {
          "required": [
            "teams"
          ]
        },
        {
          "required": [
            "roles"
          ]
        }
      ],
      "properties": {
        "custom_roles": {
          "description": "Roles created in CISO Assistant, by name, that 'roles' may name beside the built-in ones.",
          "$ref": "#/$defs/names"
        },
        "users": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/user"
          }
        },
        "teams": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/team"
          }
        },
        "roles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/role_grant"
          }
        }
      }
    },
    "user": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "email"
      ],
      "properties": {
        "email": {
          "description": "The key: the address the person signs in with. Compared without case.",
          "$ref": "#/$defs/email"
        },
        "first_name": {
          "$ref": "#/$defs/text"
        },
        "last_name": {
          "$ref": "#/$defs/text"
        },
        "active": {
          "description": "false keeps the user but blocks sign-in. A user removed from the file is deactivated by 'scope apply --prune', never deleted.",
          "enum": [
            "true",
            "false",
            true,
            false
          ]
        },
        "service_account": {
          "description": "A non-person account: 'publish' (or true) for the collector runner, which needs only analyst; 'apply' for an account that applies the scope.",
          "enum": [
            "true",
            "publish",
            "apply",
            true
          ]
        }
      }
    },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "type": "string"
        },
        "domain": {
          "description": "A domain from setup.yaml, or the root folder (Global); left out for the root folder.",
          "$ref": "#/$defs/text"
        },
        "leader": {
          "$ref": "#/$defs/email"
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/email"
          }
        }
      }
    },
    "role_grant": {
      "description": "A role on a domain, for users and for every member and the leader of teams: one role assignment per user.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "domain"
      ],
      "properties": {
        "role": {
          "description": "administrator, domain_manager, analyst, approver, auditor, baseline_reader, or a name from custom_roles.",
          "$ref": "#/$defs/text"
        },
        "domain": {
          "description": "A domain from setup.yaml, or the root folder (Global) for the whole organisation.",
          "$ref": "#/$defs/text"
        },
        "users": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/email"
          }
        },
        "teams": {
          "$ref": "#/$defs/names"
        }
      }
    },
    "settings": {
      "description": "CISO Assistant's feature flags and general settings, by name, as in the settings snapshot of the pinned release (src/EvidenceHound.Core/Scope/ciso-assistant-settings.json). Only the settings named here change. Never secrets such as openai_api_key.",
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "feature_flags"
          ]
        },
        {
          "required": [
            "general"
          ]
        }
      ],
      "properties": {
        "feature_flags": {
          "description": "Each flag on (true) or off (false).",
          "type": "object",
          "propertyNames": {
            "enum": [
              "accreditations",
              "advanced_analytics",
              "audit_tree_inheritance",
              "auditee_mode",
              "bia",
              "comments",
              "commitment_management",
              "compliance",
              "contracts",
              "control_plan",
              "custom_portals",
              "cwes",
              "data_breaches",
              "document_management",
              "dora",
              "dpias",
              "ebiosrm",
              "exceptions",
              "experimental",
              "external_ratings",
              "findings_from_requirements",
              "follow_up",
              "generic_collections",
              "incidents",
              "inherent_risk",
              "jit_provisioning",
              "journeys",
              "mcp",
              "mcp_write",
              "metrology",
              "nis2",
              "notification_center",
              "organisation_issues",
              "organisation_objectives",
              "outgoing_webhooks",
              "personal_data",
              "policy_documents",
              "posture_assessments",
              "privacy",
              "project_management",
              "projects",
              "purposes",
              "quantitative_risk_studies",
              "quick_forms",
              "relations_graph",
              "reports",
              "responsibility_matrices",
              "right_requests",
              "risk_acceptances",
              "risk_management",
              "scoring_assistant",
              "security_advisories",
              "tasks",
              "terminologies",
              "threat_modeling",
              "tprm",
              "ttps",
              "validation_flows",
              "vulnerabilities",
              "vulnerability_sla",
              "workflows",
              "xrays"
            ]
          },
          "additionalProperties": {
            "enum": [
              "true",
              "false",
              true,
              false
            ]
          }
        },
        "general": {
          "description": "Each general setting's value, as CISO Assistant stores it.",
          "type": "object",
          "propertyNames": {
            "enum": [
              "allow_assignments_to_entities",
              "allow_self_validation",
              "audit_tree_aggregation_strategy",
              "auto_lock_overdue_assessments",
              "auto_ref_id",
              "auto_ref_id_prefixes",
              "builtin_metrics_retention_days",
              "chat_system_prompt",
              "chat_temperature",
              "chat_temperature_enabled",
              "currency",
              "daily_rate",
              "default_custom_analytics_dashboard",
              "default_date_format",
              "default_landing",
              "default_language",
              "default_packager",
              "disable_partially_compliant_result",
              "disabled_email_templates",
              "documentation_score_first",
              "ebios_radar_green_zone_radius",
              "ebios_radar_max",
              "ebios_radar_red_zone_radius",
              "ebios_radar_yellow_zone_radius",
              "embedding_backend",
              "enforce_mfa",
              "evidence_four_eyes",
              "interface_agg_scenario_matrix",
              "llm_provider",
              "mapping_max_depth",
              "notifications_enable_mailing",
              "ollama_base_url",
              "ollama_embed_model",
              "ollama_model",
              "openai_api_base",
              "openai_model",
              "organisation_score_scale",
              "personal_folders",
              "personal_folders_parent",
              "report_timezone",
              "risk_matrix_flip_vertical",
              "risk_matrix_labels",
              "risk_matrix_swap_axes",
              "security_objective_scale",
              "show_get_started",
              "show_warning_external_links",
              "use_risk_category_label"
            ]
          }
        }
      }
    },
    "thirdParty": {
      "description": "scope/third-parties/<entity>.yaml: one supplier or other third party (a CISO Assistant entity) with its solutions, contracts and representatives.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref_id",
        "name"
      ],
      "properties": {
        "ref_id": {
          "$ref": "#/$defs/text"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "type": "string"
        },
        "mission": {
          "type": "string"
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$",
          "description": "ISO 3166-1 alpha-2, such as AU."
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217, such as AUD."
        },
        "parent": {
          "description": "The ref_id of another third party this one belongs to.",
          "$ref": "#/$defs/text"
        },
        "domain": {
          "description": "A domain from setup.yaml; left out for the root folder.",
          "$ref": "#/$defs/text"
        },
        "dependency": {
          "type": [
            "integer",
            "string"
          ],
          "minimum": 0,
          "maximum": 4,
          "description": "How much the organisation depends on it (0-4).",
          "pattern": "^[0-4]$"
        },
        "penetration": {
          "type": [
            "integer",
            "string"
          ],
          "minimum": 0,
          "maximum": 4,
          "description": "How far it reaches into the organisation's systems (0-4).",
          "pattern": "^[0-4]$"
        },
        "maturity": {
          "type": [
            "integer",
            "string"
          ],
          "minimum": 1,
          "maximum": 4,
          "description": "Its security maturity (1-4).",
          "pattern": "^[1-4]$"
        },
        "trust": {
          "type": [
            "integer",
            "string"
          ],
          "minimum": 1,
          "maximum": 4,
          "description": "How far it is trusted (1-4).",
          "pattern": "^[1-4]$"
        },
        "identifiers": {
          "type": "object",
          "description": "Legal identifiers by kind, such as LEI or ABN.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "solutions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref_id",
              "name"
            ],
            "properties": {
              "ref_id": {
                "$ref": "#/$defs/text"
              },
              "name": {
                "$ref": "#/$defs/text"
              },
              "description": {
                "type": "string"
              },
              "criticality": {
                "type": [
                  "integer",
                  "string"
                ],
                "minimum": 1,
                "maximum": 4,
                "description": "How critical the solution is (1-4).",
                "pattern": "^[1-4]$"
              }
            }
          }
        },
        "contracts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref_id",
              "name",
              "status"
            ],
            "properties": {
              "ref_id": {
                "$ref": "#/$defs/text"
              },
              "name": {
                "$ref": "#/$defs/text"
              },
              "description": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "draft",
                  "active",
                  "expired",
                  "terminated"
                ]
              },
              "start": {
                "$ref": "#/$defs/date"
              },
              "end": {
                "$ref": "#/$defs/date"
              },
              "annual_expense": {
                "type": [
                  "number",
                  "string"
                ]
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              },
              "solutions": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/text"
                },
                "description": "ref_ids of this third party's solutions the contract covers."
              }
            }
          }
        },
        "representatives": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "email"
            ],
            "properties": {
              "email": {
                "$ref": "#/$defs/email"
              },
              "first_name": {
                "type": "string"
              },
              "last_name": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "phone": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
