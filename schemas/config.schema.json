{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tnbozman/evidence-hound/schemas/config.schema.json",
  "title": "Evidence Hound deployment config",
  "description": "One deployment: how to reach CISO Assistant, where evidence is stored, which collectors run and which audit they update. Secrets are references only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ciso_assistant", "evidence", "collectors", "target"],
  "properties": {
    "ciso_assistant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "token"],
      "properties": {
        "url": { "description": "CISO Assistant API address, for example http://localhost:8000/api/. HOUND_CA_URL overrides it.", "type": "string", "pattern": "^https?://" },
        "token": { "$ref": "#/$defs/secretReference" },
        "transport": { "enum": ["rest", "kafka"], "default": "rest" },
        "kafka_bootstrap_servers": { "type": "string", "minLength": 1 }
      },
      "if": { "properties": { "transport": { "const": "kafka" } }, "required": ["transport"] },
      "then": { "required": ["kafka_bootstrap_servers"] }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root"],
      "properties": {
        "root": { "description": "Evidence folder, relative to the config file.", "type": "string", "minLength": 1 },
        "retention_days": { "description": "Delete runs older than this; the latest successful run is always kept.", "type": "integer", "minimum": 1 }
      }
    },
    "collectors": {
      "type": "array",
      "items": { "$ref": "#/$defs/collector" }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mapping", "compliance_assessment"],
      "properties": {
        "mapping": { "description": "Framework mapping file, relative to the config file.", "type": "string", "minLength": 1 },
        "compliance_assessment": { "description": "The audit's ref_id in CISO Assistant.", "type": "string", "minLength": 1 },
        "controls": {
          "description": "Control key to applied control ref_id in CISO Assistant.",
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "secretReference": {
      "description": "env:NAME for an environment variable or file:/absolute/path for a file such as a Docker secret. Never the secret itself.",
      "type": "string",
      "pattern": "^(env:[A-Za-z_][A-Za-z0-9_]*|file:/.+)$"
    },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "schedule"],
      "properties": {
        "name": { "description": "Unique; names the evidence folder.", "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "type": { "description": "A collector type this build knows, for example fake.", "type": "string", "minLength": 1 },
        "schedule": { "description": "Five-field cron expression, UTC.", "type": "string", "pattern": "^\\s*[0-9A-Za-z*/,-]+(\\s+[0-9A-Za-z*/,-]+){4}\\s*$" },
        "settings": {
          "description": "Plain, non-secret settings for the collector.",
          "type": ["object", "null"],
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        },
        "secrets": {
          "description": "Secret references the collector resolves at run time.",
          "type": ["object", "null"],
          "additionalProperties": { "$ref": "#/$defs/secretReference" }
        }
      }
    }
  }
}
