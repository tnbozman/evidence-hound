# Settings for the reference Compose stack (deploy/compose/compose.yml). Copy to .env next to compose.yml
# (git-ignored) or keep the non-secret settings in your private compliance repo as deploy/deploy.env and pass
# --env-file. Nothing here is secret: secrets are files in HOUND_SECRETS_DIR, never variables.
# Everything below is fictional (Example Pty Ltd).

# The Compose files, separated by ':'. Add your private compliance repo's override after the stack, such as
# compose.yml:/opt/compliance/deploy/compose.override.yml (docs/tutorials/first-deployment.md).
COMPOSE_FILE=compose.yml

# CISO Assistant release (images ghcr.io/intuitem/ciso-assistant-community/*). Snapshot the VM before upgrading.
CA_VERSION=v4.3.4
# Host name people and the runner use for CISO Assistant, and the HTTPS port Caddy listens on.
CA_HOSTNAME=ciso.example.com
CA_HTTPS_PORT=443
# Time zone for the containers' clocks and logs (the runner's schedules carry their own time zone).
TZ=Australia/Sydney
# PostgreSQL database and user for CISO Assistant (the password is the postgres_password secret).
POSTGRES_DB=ciso_assistant
POSTGRES_USER=ciso_assistant

# The collector runner image, pinned to a release (see docs/running.md and docs/deploy/updates.md).
HOUND_RUNNER_IMAGE=ghcr.io/tnbozman/evidence-hound:1.0.1
# Your private compliance repo checked out on the host; mounted read-only at /config.
HOUND_CONFIG_DIR=/opt/compliance
# The deployment config inside it, relative to HOUND_CONFIG_DIR.
HOUND_CONFIG_FILE=hound.yaml
# Folder of Docker secrets files on the host (postgres_password, django_secret_key, hound_ca_token,
# m365_client_certificate). Outside any git repo, owned by root, files mode 0444 or tighter group access.
HOUND_SECRETS_DIR=/etc/evidence-hound/secrets

