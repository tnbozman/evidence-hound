{
  "name": "Evidence Hound (.NET 10)",
  // The dev service plus a seeded CISO Assistant on one network (see compose.yml).
  "dockerComposeFile": "compose.yml",
  "service": "dev",
  "workspaceFolder": "/workspaces/evidence-hound",
  "shutdownAction": "stopCompose",
  "initializeCommand": "bash .devcontainer/initialize.sh",
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "10.0.1xx"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:4": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    // terraform test for the tutorial's control tests (make test-terraform); hound itself never runs Terraform.
    "ghcr.io/devcontainers/features/terraform:1": {
      "version": "1.13.4"
    },
    "ghcr.io/devcontainers/features/node:2": {
      "version": "lts"
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },
  "containerEnv": {
    "DOTNET_NOLOGO": "true",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "true",
    "TESTCONTAINERS_RYUK_DISABLED": "false"
  },
  // CISO Assistant's UI is published on the host at https://localhost:8443 by the caddy service.
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash scripts/dev-ca-env.sh || echo 'CISO Assistant is not ready yet; run scripts/dev-ca-env.sh later.'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "ms-dotnettools.vscode-dotnet-runtime",
        "anthropic.claude-code",
        "github.vscode-github-actions",
        "github.vscode-pull-request-github",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml",
        "editorconfig.editorconfig",
        "davidanson.vscode-markdownlint",
        "ryanluker.vscode-coverage-gutters",
        "timonwong.shellcheck",
        "jetmartin.bats"
      ],
      "settings": {
        "dotnet.defaultSolution": "EvidenceHound.slnx",
        "dotnet.testWindow.useTestingPlatformProtocol": true,
        "editor.formatOnSave": true,
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        "yaml.schemas": {
          "./schemas/config.schema.json": ["examples/*.yaml", "deploy/**/hound*.yaml"],
          "./schemas/mapping.schema.json": ["mappings/*.yaml"]
        },
        "coverage-gutters.coverageFileNames": ["coverage.cobertura.xml"]
      }
    }
  }
}
