{
  "name": "Evidence Hound (.NET 10)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "10.0"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/node:2": {
      "version": "lts"
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },
  "containerEnv": {
    "DOTNET_NOLOGO": "true",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "true",
    "TESTCONTAINERS_RYUK_DISABLED": "false"
  },
  "forwardPorts": [8443],
  "portsAttributes": {
    "8443": { "label": "CISO Assistant (local)", "protocol": "https" }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "ms-dotnettools.vscode-dotnet-runtime",
        "anthropic.claude-code",
        "github.vscode-github-actions",
        "github.vscode-pull-request-github",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml",
        "editorconfig.editorconfig",
        "davidanson.vscode-markdownlint",
        "ryanluker.vscode-coverage-gutters",
        "timonwong.shellcheck",
        "jetmartin.bats"
      ],
      "settings": {
        "dotnet.defaultSolution": "EvidenceHound.slnx",
        "dotnet.testWindow.useTestingPlatformProtocol": true,
        "editor.formatOnSave": true,
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        "yaml.schemas": {
          "./schemas/config.schema.json": ["examples/*.yaml", "deploy/**/hound*.yaml"],
          "./schemas/mapping.schema.json": ["mappings/*.yaml"]
        },
        "coverage-gutters.coverageFileNames": ["coverage.cobertura.xml"]
      }
    }
  }
}
