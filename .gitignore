!examples/**/*.pdf

# Claude Code: personal settings stay on each developer's machine
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db

# Local hound onboard config and sessions from running hound in this checkout; they belong in a compliance repo, never here.
/onboarding.yaml
/onboarding/*/

